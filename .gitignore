.claude/
.cursor/
.vscode/

# Secrets and credentials
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*

# Node
node_modules/

# OS junk
.DS_Store
Thumbs.db
*.swp
*~

# Build artifacts
*.o
*.so
*.dylib

# Probe copies deployed into the loader dir (recreated by deploy.sh)
tools/remote-loader/p[0-9]*.js
tools/remote-loader/__pycache__/
